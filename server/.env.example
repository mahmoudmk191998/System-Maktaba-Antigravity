# ==============================================================================
# RMS (Restaurant Management System) Production Environment Configuration
# Universal Multi-Tenant SaaS Platform Backend
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE SERVER RUNTIME (Required)
# ------------------------------------------------------------------------------
NODE_ENV=production
PORT=4000

# ------------------------------------------------------------------------------
# 2. CORS & SECURITY (Required for Production)
# Comma-separated list of allowed origins. Wildcards (*) are strictly forbidden in production.
# ------------------------------------------------------------------------------
ALLOWED_ORIGINS=https://app.your-rms-domain.com,https://your-restaurant-website.com

# ------------------------------------------------------------------------------
# 3. FIREBASE ADMIN SDK CREDENTIALS (Required)
# Stored securely on the server only. NEVER expose in frontend builds.
# Option A: Inline Service Account Credentials
# ------------------------------------------------------------------------------
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-firebase-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# Option B: Path to Service Account JSON file (Alternative to Option A)
# FIREBASE_SERVICE_ACCOUNT_PATH=/etc/secrets/serviceAccountKey.json

# ------------------------------------------------------------------------------
# 4. DISTRIBUTED RATE LIMITING
# Store options: 'in-memory' (single instance) or 'redis' (distributed clusters)
# ------------------------------------------------------------------------------
RATE_LIMIT_STORE=in-memory
API_RATE_LIMIT_DEFAULT=100
API_RATE_LIMIT_STANDARD=500
API_RATE_LIMIT_PREMIUM=2000
API_RATE_WINDOW_MS=60000

# ------------------------------------------------------------------------------
# 5. REDIS DISTRIBUTED INFRASTRUCTURE (Optional, Recommended for Multi-Instance)
# Required when RATE_LIMIT_STORE=redis, WEBHOOK_QUEUE_PROVIDER=redis, or REALTIME_EVENT_BUS_PROVIDER=redis
# ------------------------------------------------------------------------------
# REDIS_URL=rediss://default:your-secure-redis-password@your-redis-host.upstash.io:6379
REDIS_RATE_LIMIT_PREFIX=rms:ratelimit:
REDIS_QUEUE_PREFIX=rms:webhook_queue:

# ------------------------------------------------------------------------------
# 6. DISTRIBUTED WEBHOOK QUEUE & WORKERS
# Provider options: 'in-memory' or 'redis'
# ------------------------------------------------------------------------------
WEBHOOK_QUEUE_PROVIDER=in-memory
WEBHOOK_WORKER_ENABLED=true
WEBHOOK_WORKER_CONCURRENCY=5
WEBHOOK_LEASE_SECONDS=60
WEBHOOK_POLL_INTERVAL_MS=1000
WEBHOOK_MAX_ATTEMPTS=5
WEBHOOK_BASE_DELAY_SECONDS=10
WEBHOOK_MAX_DELAY_SECONDS=300
WEBHOOK_REQUEST_TIMEOUT_MS=10000

# ------------------------------------------------------------------------------
# 7. WEBHOOK CIRCUIT BREAKER
# ------------------------------------------------------------------------------
WEBHOOK_CIRCUIT_FAILURE_THRESHOLD=5
WEBHOOK_CIRCUIT_COOLDOWN_SECONDS=60
WEBHOOK_CIRCUIT_HALF_OPEN_REQUESTS=1

# ------------------------------------------------------------------------------
# 8. REALTIME EVENT PLATFORM (SSE & WEBSOCKETS)
# Provider options: 'in-memory' or 'redis'
# ------------------------------------------------------------------------------
# REALTIME_EVENT_BUS_PROVIDER=in-memory
# REALTIME_EVENT_REPLAY_ENABLED=true
# REALTIME_EVENT_REPLAY_MAX_EVENTS=1000
# REALTIME_EVENT_REPLAY_RETENTION_SECONDS=86400
# REALTIME_MAX_CONNECTIONS_PER_TENANT=100
# REALTIME_MAX_CONNECTIONS_PER_INTEGRATION=20
# REALTIME_MAX_SUBSCRIPTIONS_PER_CONNECTION=20
